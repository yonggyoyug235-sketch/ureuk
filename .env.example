# 로컬 개발: 파일 기반 SQLite (그대로 두면 됩니다)
DATABASE_URL="file:./data/app.db"
DATABASE_AUTH_TOKEN=""

# 프로덕션(Turso)에서는 아래 이름도 인식합니다.
# Vercel Marketplace의 Turso 연동을 붙이면 이 두 개가 자동으로 주입됩니다.
# TURSO_DATABASE_URL="libsql://<your-db>-<org>.turso.io"
# TURSO_AUTH_TOKEN="<turso db token>"

# 세션 서명 키 (32자 이상). 배포 전 반드시 교체
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
